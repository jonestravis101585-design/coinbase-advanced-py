# Copy to examples/coinbase_agent/.env, which is ignored by Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Use an absolute path to your downloaded Coinbase CDP key JSON file.
COINBASE_KEY_FILE=

# Alternatively, leave COINBASE_KEY_FILE empty and set this pair.
COINBASE_API_KEY=
COINBASE_API_SECRET=
